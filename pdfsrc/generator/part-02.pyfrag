def page_footer(canvas, doc, lang):
    canvas.saveState()
    w, h = A4
    canvas.setStrokeColor(LINE)
    canvas.setLineWidth(0.35)
    canvas.line(16*mm, 13*mm, w-16*mm, 13*mm)
    canvas.setFont('Helvetica', 7.5)
    canvas.setFillColor(MUTED)
    canvas.drawString(16*mm, 8*mm, 'Umar Junaedi - Senior IT Manager')
    canvas.drawRightString(w-16*mm, 8*mm, f"{('Halaman' if lang=='id' else 'Page')} {doc.page}")
    canvas.restoreState()


